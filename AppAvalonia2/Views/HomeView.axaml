<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AppAvalonia2.Views.Home">

  <StackPanel Margin="16" Spacing="16">

    <Border Background="#1F2937" CornerRadius="16" Padding="16">
      <StackPanel>
        <TextBlock Text="Mi Granja" FontSize="18" Foreground="#AA2A2A"/>
        <TextBlock Text="8 Aves • 3666 Huevos" Foreground="#9CA3AF"/>
      </StackPanel>
    </Border>

    <Border Background="#1F2937" CornerRadius="16" Padding="16">
      <StackPanel>
        <TextBlock Text="Granja Norte" FontSize="18" Foreground="#922323"/>
        <TextBlock Text="24 Aves • 8120 Huevos" Foreground="#9CA3AF"/>
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>