<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AppAvalonia2.ViewModels"
             x:DataType="vm:LayoutViewModel"
             x:Class="AppAvalonia2.Views.Layout">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- HEADER -->
    <Border Background="#111827" Padding="16" CornerRadius="0,0,20,20">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <Ellipse Width="40" Height="40" Fill="#34D399"/>

        <TextBlock Text="Granjas"
                   FontSize="20"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="12,0"
                   Foreground="White"/>

        <Button Content="⚙"
                Width="40" Height="40"
                CornerRadius="20"/>

      </Grid>
    </Border>

    <!-- CONTENIDO -->
    <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>

    <!-- NAVBAR -->
    <Border Grid.Row="2" Background="#111827" Padding="10" CornerRadius="20,20,0,0">
      <Grid ColumnDefinitions="*,*,*,*,*">

        <Button Content="🏠" Command="{Binding GoHome}"/>
        <Button Content="🐔" Grid.Column="1" Command="{Binding GoAves}"/>
        <Button Content="🥚" Grid.Column="2" Command="{Binding GoHuevos}"/>
        <Button Content="🌽" Grid.Column="3" Command="{Binding GoComida}"/>
        <Button Content="📊" Grid.Column="4" Command="{Binding GoGraficas}"/>

      </Grid>
    </Border>

  </Grid>
</UserControl>