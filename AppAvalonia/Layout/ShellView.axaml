<!-- /Layout/ShellView.axaml -->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AppAvalonia.ViewModels"
             x:Class="AppAvalonia.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             Background="{StaticResource BgDeepBrush}">

    <Grid RowDefinitions="Auto, *, Auto">

        <Grid Grid.Row="0" Margin="20,52,20,16" ColumnDefinitions="Auto,*,Auto">
            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#1C2128" Margin="0,0,12,0">
                <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Row="0" Grid.Column="0" Width="8" Height="8" Fill="#F87171" Margin="0,0,1,1"/>
                    <Ellipse Grid.Row="0" Grid.Column="1" Width="8" Height="8" Fill="#4ADE80" Margin="1,0,0,1"/>
                    <Ellipse Grid.Row="1" Grid.Column="0" Width="8" Height="8" Fill="#60A5FA" Margin="0,1,1,0"/>
                    <Ellipse Grid.Row="1" Grid.Column="1" Width="8" Height="8" Fill="#FBBF24" Margin="1,1,0,0"/>
                </Grid>
            </Border>

            <TextBlock Grid.Column="1"
                       Text="{Binding Title}"
                       Classes="H1"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="2" Classes="Ghost" Width="40" Height="40" Padding="0" CornerRadius="12" Background="#1C2128">
                <TextBlock Text="⚙" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </Grid>

        <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>

        <Border Grid.Row="2" Background="#111418" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="8,8,8,28">
            <Grid ColumnDefinitions="*,*,*,*,*">
                <Button Grid.Column="0" Classes="Ghost" HorizontalAlignment="Center" Command="{Binding NavHomeCommand}">
                    <Border Background="#1A3A1A" CornerRadius="12" Padding="10,8">
                        <TextBlock Text="🏠" FontSize="20"/>
                    </Border>
                </Button>
                <Button Grid.Column="1" Classes="Ghost" HorizontalAlignment="Center" Command="{Binding NavAvesCommand}">
                    <TextBlock Text="🐦" FontSize="22"/>
                </Button>
                <Button Grid.Column="2" Classes="Ghost" HorizontalAlignment="Center">
                    <TextBlock Text="🥚" FontSize="22"/>
                </Button>
                <Button Grid.Column="3" Classes="Ghost" HorizontalAlignment="Center">
                    <TextBlock Text="🌽" FontSize="22"/>
                </Button>
                <Button Grid.Column="4" Classes="Ghost" HorizontalAlignment="Center">
                    <TextBlock Text="📈" FontSize="22"/>
                </Button>
            </Grid>
        </Border>

    </Grid>
</UserControl>
