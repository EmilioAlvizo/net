<!-- /views/CollaboratorsView.axaml -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AppAvalonia3.ViewModels"
             xmlns:models="using:AppAvalonia3.Models"
             xmlns:viewmodels="using:AppAvalonia3.ViewModels"
             x:Class="AppAvalonia3.Views.CollaboratorsView"
             x:DataType="vm:CollaboratorsViewModel"
             Background="{StaticResource BgDeepBrush}">

    <UserControl.Styles>
        <Style Selector="Button.roleCard > Border">
            <Setter Property="Background" Value="#1C1E18"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.roleCard.selected > Border">
            <Setter Property="Background" Value="#24221A"/>
            <Setter Property="BorderBrush" Value="#EAA850"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <Grid RowDefinitions="Auto, Auto, *">
            <StackPanel Grid.Row="0" Margin="20,40,20,10">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Button Command="{Binding BackCommand}" Background="Transparent" Padding="10">
                        <TextBlock Text="←" FontSize="24" Foreground="White"/>
                    </Button>
                    <TextBlock Grid.Column="1" Text="Colaboradores" Classes="H1"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Button Grid.Column="2" Background="Transparent">
                        <TextBlock Text="⚙" FontSize="20" Foreground="Gray"/>
                    </Button>
                </Grid>
                <TextBlock Text="Invita a personas a ver o administrar tu granja."
                           Classes="Subtitle" Margin="0,15,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="#1A1C14" CornerRadius="15" Margin="20,10" Padding="15">
                <StackPanel Orientation="Horizontal" Spacing="15">
                    <TextBlock Text="🛡" FontSize="24" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Roles disponibles" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Admin puede crear y editar todo. Visor sólo puede ver."
                                   Classes="Muted" TextWrapping="Wrap" MaxWidth="250"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2" Margin="20,0">
                <ItemsControl ItemsSource="{Binding Members}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:MiembroGranja">
                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="15"
                                    Margin="0,0,0,10" Padding="15" PointerPressed="OnMemberCardPressed"
                                    Cursor="Hand">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <Border Width="45" Height="45" CornerRadius="22" Background="#2A2D24" >
                                        <TextBlock Text="{Binding Perfiles.Nombre}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="Bold"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="15,0">
                                        <TextBlock Text="{Binding Granjas.Nombre}" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="{Binding Perfiles.Email}" Classes="Muted" FontSize="12"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Padding="10,4" CornerRadius="12"
                                            Background="#2A2D24" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Ellipse Width="6" Height="6" Fill="#A4DE80" />
                                            <TextBlock Text="{Binding Rol}" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Grid.Row="2" Width="60" Height="60" CornerRadius="30"
                    Background="#A4DE80" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,20,30" Command="{Binding OpenAddMemberCommand}">
                <TextBlock Text="+" FontSize="30" Foreground="#1A1C14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </Grid>

        <Grid Background="#B0000000"
              IsVisible="{Binding IsEditRoleOpen}"
              RowDefinitions="*, Auto">

            <Button Grid.Row="0" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Command="{Binding CloseEditRoleCommand}"/>

            <Border Grid.Row="1" Background="#141612" CornerRadius="24,24,0,0" Padding="20,15,20,30">
                <StackPanel Spacing="15">
                    <Border Width="40" Height="4" Background="#3A3D34" CornerRadius="2" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel>
                            <TextBlock Text="Editar rol" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding SelectedMemberForEdit.Perfiles.Nombre}" Classes="Muted" FontSize="14" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding CloseEditRoleCommand}" Background="Transparent" Padding="5">
                            <TextBlock Text="✕" FontSize="18" Foreground="Gray"/>
                        </Button>
                    </Grid>

                    <Border Background="#24221A" BorderBrush="#EAA850" BorderThickness="1" CornerRadius="15" Padding="15">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Border Width="40" Height="40" Background="#EAA850" CornerRadius="12">
                                <TextBlock Text="🛡️" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="15,0" VerticalAlignment="Center">
                                <TextBlock Text="Admin" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Puede crear, editar y eliminar" Classes="Muted" FontSize="12"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="✓" Foreground="#EAA850" Background="Transparent"
                                    Command="{Binding ChangeRoleCommand}" CommandParameter="Admin"/>
                        </Grid>
                    </Border>

                    <Border Background="#1A1C15" CornerRadius="15" Padding="15">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Border Width="40" Height="40" Background="#2A2D24" CornerRadius="12">
                                <TextBlock Text="👁️" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="15,0" VerticalAlignment="Center">
                                <TextBlock Text="Visor" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Sólo puede ver información" Classes="Muted" FontSize="12"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="" Background="Transparent"
                                    Command="{Binding ChangeRoleCommand}" CommandParameter="Visor"/>
                        </Grid>
                    </Border>

                    <Separator Background="#2A2D24" Margin="0,10"/>

                    <Button Command="{Binding RevokeAccessCommand}" Background="Transparent" HorizontalAlignment="Center">
                        <TextBlock Text="Revocar acceso" Foreground="#FF6B6B" FontWeight="Bold" FontSize="15"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Background="#B0000000"
              IsVisible="{Binding IsAddMemberOpen}"
              RowDefinitions="*, Auto">

            <Button Grid.Row="0" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Command="{Binding CloseAddMemberCommand}"/>

            <Border Grid.Row="1" Background="#141612" CornerRadius="24,24,0,0" Padding="20,15,20,30">
                <StackPanel Spacing="18">
                    <Border Width="40" Height="4" Background="#3A3D34" CornerRadius="2" HorizontalAlignment="Center" Margin="0,0,0,5"/>

                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Invitar colaborador" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Recibirá un correo con el enlace para unirse" Foreground="#7A7D74" FontSize="13"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding CloseAddMemberCommand}" Background="Transparent" Padding="5" VerticalAlignment="Top">
                            <TextBlock Text="✕" FontSize="18" Foreground="#7A7D74"/>
                        </Button>
                    </Grid>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Correo electrónico" FontSize="14" Foreground="White" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding InviteEmail, Mode=TwoWay}"
                                 Watermark="persona@correo.com"
                                 Background="#1C1E18"
                                 BorderThickness="0"
                                 CornerRadius="14"
                                 Padding="14,12"
                                 Foreground="White"/>
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock Text="Permisos" FontSize="14" Foreground="White" FontWeight="SemiBold"/>

                        <Grid ColumnDefinitions="*, *">

                            <Button Grid.Column="0"
                                    Classes="roleCard"
                                    Classes.selected="{Binding IsVisorSelected}"
                                    Command="{Binding SelectInviteRoleCommand}" CommandParameter="viewer"
                                    Background="Transparent" Padding="0" Margin="0,0,6,0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Border CornerRadius="16" Padding="15" Height="110">
                                    <StackPanel VerticalAlignment="Bottom" Spacing="4">
                                        <Border Width="36" Height="36" Background="#EAA850" CornerRadius="10" HorizontalAlignment="Left" Margin="0,0,0,8"
                                                IsVisible="{Binding IsVisorSelected}">
                                            <TextBlock Text="👁️" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                        </Border>
                                        <Border Width="36" Height="36" Background="#141612" CornerRadius="10" HorizontalAlignment="Left" Margin="0,0,0,8"
                                                IsVisible="{Binding !IsVisorSelected}">
                                            <TextBlock Text="👁️" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                        </Border>

                                        <TextBlock Text="Visor" FontWeight="Bold" Foreground="White" FontSize="16"/>
                                        <TextBlock Text="Solo lectura" Foreground="#7A7D74" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Button>

                            <Button Grid.Column="1"
                                    Classes="roleCard"
                                    Classes.selected="{Binding IsAdminSelected}"
                                    Command="{Binding SelectInviteRoleCommand}" CommandParameter="editor"
                                    Background="Transparent" Padding="0" Margin="6,0,0,0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Border CornerRadius="16" Padding="15" Height="110">
                                    <StackPanel VerticalAlignment="Bottom" Spacing="4">
                                        <Border Width="36" Height="36" Background="#EAA850" CornerRadius="10" HorizontalAlignment="Left" Margin="0,0,0,8"
                                                IsVisible="{Binding IsAdminSelected}">
                                            <TextBlock Text="🛡️" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                        </Border>
                                        <Border Width="36" Height="36" Background="#141612" CornerRadius="10" HorizontalAlignment="Left" Margin="0,0,0,8"
                                                IsVisible="{Binding !IsAdminSelected}">
                                            <TextBlock Text="🛡️" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                        </Border>

                                        <TextBlock Text="Admin" FontWeight="Bold" Foreground="White" FontSize="16"/>
                                        <TextBlock Text="Crear y editar" Foreground="#7A7D74" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Button>

                        </Grid>

                        <TextBlock Text="Puedes cambiar el rol en cualquier momento" Foreground="#5A5D54" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Command="{Binding ExecuteAddMemberCommand}"
                            Background="#EAA850"
                            CornerRadius="24"
                            Height="50"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="➔" Foreground="#141612" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="Enviar invitación" Foreground="#141612" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

    </Panel>
</UserControl>