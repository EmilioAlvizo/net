<!-- /MainWindow.axaml -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AppAvalonia3.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:AppAvalonia3.Views"
        mc:Ignorable="d" Width="360" Height="800"
        x:Class="AppAvalonia3.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="AppAvalonia3">

    <!-- MAPEO: ViewModel -> Vista -->
    <Window.DataTemplates>
        <DataTemplate DataType="vm:LoginViewModel"><views:LoginView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnimalesViewModel}">
            <views:AnimalesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HuevosViewModel}">
            <views:HuevosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AddFarmViewModel}">
            <views:AddFarmView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CollaboratorsViewModel}">
            <views:CollaboratorsView />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- 1. CABECERA (FIJA) -->
        <Grid Grid.Row="0" IsVisible="{Binding IsLoggedIn}" Margin="20,52,20,16" ColumnDefinitions="Auto, *, Auto">
            <!-- Icono de la App -->
            <Ellipse Grid.Column="0" Width="35" Height="35" Fill="Gray"/>

            <!-- Título Central -->
            <TextBlock Grid.Column="1" Text="Granjas"
                       FontSize="22" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="15,0"/>

            <!-- Botón Settings -->
            <Button Grid.Column="2"
                    Classes="Ghost"
                    Width="40" Height="40"
                    Padding="0"
                    CornerRadius="12"
                    Background="#1C2128"
                    >
                <TextBlock Text="⚙" FontSize="18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Button>
        </Grid>

        <!-- 2. CONTENIDO DINÁMICO (Scrollable) -->
        <ScrollViewer Grid.Row="1">
            <ContentControl Content="{Binding CurrentView}"/>
        </ScrollViewer>

        <!-- 3. BARRA DE NAVEGACIÓN INFERIOR (FIJA) -->
        <Border Grid.Row="2" IsVisible="{Binding IsLoggedIn}" Background="#1a1a1a" CornerRadius="20,20,0,0" Padding="10">
            <UniformGrid Columns="5">
                <Button Command="{Binding ShowHomeCommand}" Classes="Ghost" HorizontalAlignment="Center">
                    <TextBlock Text="🏠" FontSize="20"/>
                </Button>
                <Button Grid.Column="2" Classes="Ghost" Command="{Binding ShowAnimalesCommand}" Background="#00992020" HorizontalAlignment="Center">
                    <TextBlock Text="🐓" FontSize="20"/>
                </Button>
                <Button Grid.Column="2" Classes="Ghost" Command="{Binding ShowHuevosCommand}" Background="#00992020" HorizontalAlignment="Center">
                    <TextBlock Text="🥚" FontSize="20"/>
                </Button>
                <!-- Repite para los otros 4 iconos (Gallina, Huevo, Trigo, Gráfica) -->
                <Button Grid.Column="3" Classes="Ghost" HorizontalAlignment="Center"
                        >
                    <TextBlock Text="🌽" FontSize="22"/>
                </Button>
                <Button Background="Transparent" HorizontalAlignment="Center">
                    <PathIcon Data="{StaticResource food_egg_regular}" />
                </Button>
            </UniformGrid>
        </Border>
    </Grid>
</Window>
